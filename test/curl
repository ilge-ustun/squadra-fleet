#!/usr/bin/env bash
#
# fleet/test/curl — stand-in for curl under fleet/test-lib.sh.
#
# fleet/telegram.sh calls `curl` by bare name, so this shadows it on PATH and
# no test ever reaches api.telegram.org. Two requests exist:
#
#   …/sendMessage   records the request and answers {"ok":true}
#   …/getUpdates    answers with the contents of $FAKE_TELEGRAM_UPDATES, or an
#                   empty result when that is not set
#
# Every call is recorded twice: the argv in $FAKE_TRACE_DIR/curl-calls (one
# line each, so a test can count them) and the full argument list in
# curl-args-N, which is where the message text can be read back.
#
# FAKE_CURL=fail makes every request fail, for the case that asks what happens
# when Telegram is unreachable.
#
set -uo pipefail
: "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}"

url=""
for a in "$@"; do
  case "$a" in https://*|http://*) url="$a" ;; esac
done

echo "curl $url" >> "$FAKE_TRACE_DIR/curl-calls"
n="$(grep -c '^curl ' "$FAKE_TRACE_DIR/curl-calls")"
printf '%s\n' "$@" > "$FAKE_TRACE_DIR/curl-args-$n"

if [[ "${FAKE_CURL:-ok}" == fail ]]; then
  echo "fake curl: refusing to connect" >&2
  exit 7
fi

case "$url" in
  *sendMessage*)
    echo '{"ok":true,"result":{"message_id":1}}' ;;
  *getUpdates*)
    if [[ -n "${FAKE_TELEGRAM_UPDATES:-}" && -f "$FAKE_TELEGRAM_UPDATES" ]]; then
      cat "$FAKE_TELEGRAM_UPDATES"
    else
      echo '{"ok":true,"result":[]}'
    fi ;;
  *)
    echo '{"ok":true,"result":[]}' ;;
esac
