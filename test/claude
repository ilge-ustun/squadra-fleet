#!/usr/bin/env bash
#
# fleet/test/claude — stand-in for the real `claude -p …` under fleet/test-lib.sh.
#
# The launcher invokes `claude` by bare name with cwd = the builder worktree
# (launch.sh: `cd "$BUILDER_WT" && claude -p "$PROMPT" …`). This script is
# found first on PATH and does exactly one scripted thing:
#
#   FAKE_BUILDER=commit     one empty commit  (the postcondition the launcher checks)
#   FAKE_BUILDER=nocommit   nothing
#   FAKE_BUILDER=blocked    writes .blocked/$FAKE_STORY_ID.md, no commit
#   FAKE_BUILDER=touch      appends a line to $FAKE_TOUCH and commits it
#                           (Phase 2: a change the scope check can see)
#
# Phase 3: FAKE_BUILDER_MUTATIONS makes the builder hand the harness its own
# TDD evidence — "the test I wrote goes red when the behaviour is removed" —
# in the same .review-out/mutations/ format the reviewer uses, slug-prefixed
# `tdd-` so the producer is visible:
#
#   none   (default) writes nothing
#   red    a patch that inserts FLEET_MUTANT_MARKER — the fake vitest in
#          `marker` mode then fails, so the claim holds
#   green  a patch that changes a comment only — nothing fails, so the
#          builder's "observed red" claim is false and the story must not pass
#
# It records every call in $FAKE_TRACE_DIR/calls and saves the prompt it was
# given as $FAKE_TRACE_DIR/claude-prompt-N, so a test can assert which prompt
# the launcher rendered. Output is the one JSON object the launcher parses
# with jq (launch.sh: `.is_error`, `.result`).
#
set -euo pipefail
: "${FAKE_BUILDER:?FAKE_BUILDER must be set}"
: "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}"

# The prompt arrives on stdin (launch.sh pipes it — a 134 KB round-2 prompt
# exceeded the kernel's per-argument limit on 007's rerun) or, for older
# callers, as the value after -p. A `-p` followed by another flag has no value.
prompt=""
while (($#)); do
  case "$1" in
    -p) if [[ -n "${2:-}" && "${2:-}" != -* ]]; then prompt="$2"; shift 2; else shift; fi ;;
    *)  shift ;;
  esac
done
if [[ -z "$prompt" && ! -t 0 ]]; then prompt="$(cat)"; fi

echo claude >> "$FAKE_TRACE_DIR/calls"
n="$(grep -c '^claude$' "$FAKE_TRACE_DIR/calls")"
printf '%s' "$prompt" > "$FAKE_TRACE_DIR/claude-prompt-$n"

case "$FAKE_BUILDER" in
  commit)   git commit -q --allow-empty -m "fake(builder): round $n" ;;
  nocommit) : ;;
  blocked)  mkdir -p .blocked
            printf 'fake question: which option?\n' > ".blocked/${FAKE_STORY_ID:?FAKE_STORY_ID must be set}.md" ;;
  touch)    printf '\nfake builder touched this (call %s)\n' "$n" >> "${FAKE_TOUCH:?FAKE_TOUCH must be set}"
            git add -- "$FAKE_TOUCH"
            git commit -q -m "fake(builder): touch $FAKE_TOUCH" ;;
  *) echo "fleet/test/claude: unknown FAKE_BUILDER='$FAKE_BUILDER'" >&2; exit 2 ;;
esac

# TDD evidence, written after the commit so the tree is clean apart from
# .review-out/ — the same contract the reviewer is held to.
case "${FAKE_BUILDER_MUTATIONS:-none}" in
  none) : ;;
  red)   mkdir -p .review-out/mutations
         printf '\nFLEET_MUTANT_MARKER\n' >> fleet/prompts/rules.md
         git diff -- fleet/prompts/rules.md > .review-out/mutations/AC1-tdd-observed-red.patch
         git checkout -q -- fleet/prompts/rules.md
         printf 'fake.test.tsx\n' > .review-out/mutations/AC1-tdd-observed-red.test ;;
  green) mkdir -p .review-out/mutations
         printf '\n# a comment the suite cannot see\n' >> fleet/prompts/rules.md
         git diff -- fleet/prompts/rules.md > .review-out/mutations/AC1-tdd-observed-red.patch
         git checkout -q -- fleet/prompts/rules.md
         printf 'fake.test.tsx\n' > .review-out/mutations/AC1-tdd-observed-red.test ;;
  *) echo "fleet/test/claude: unknown FAKE_BUILDER_MUTATIONS='$FAKE_BUILDER_MUTATIONS'" >&2; exit 2 ;;
esac

printf '{"is_error":false,"result":"fake builder did: %s (call %s)"}\n' "$FAKE_BUILDER" "$n"
