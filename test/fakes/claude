#!/usr/bin/env bash
#
# fleet/test/fakes/claude — stand-in for the real `claude -p …` under fleet/test/suite.sh.
#
# The launcher invokes `claude` by bare name with cwd = the builder worktree
# (ts/src/lib/agents.ts: `claude -p --model … --max-turns … --allowedTools …
# --output-format json`, the prompt on stdin); fleet write-story makes the
# same call from its own worktree. This script is found first on PATH and
# does exactly one scripted thing:
#
#   FAKE_BUILDER=commit     one empty commit  (the postcondition the launcher checks)
#   FAKE_BUILDER=nocommit   nothing
#   FAKE_BUILDER=blocked    writes .blocked/$FAKE_STORY_ID.md, no commit
#   FAKE_BUILDER=hang       never returns — for the agent-timeout case
#   FAKE_BUILDER=touch      appends a line to $FAKE_TOUCH and commits it
#                           (Phase 2: a change the scope check can see)
#   FAKE_BUILDER=limit      Claude refused the call: nothing done, and the one
#                           object claude -p ends in on an API error — is_error,
#                           api_error_status 429, the limit's text — exit 1
#   FAKE_BUILDER=commit-then-limit   one commit, then the same refusal
#
# Called in a reviewer worktree (cwd *-review) it is the fallback reviewer a
# human's /fallback asks for: it records `claude-review` in calls (so
# `calls claude` still counts builders), writes FAKE_MUTATIONS=patch's marker
# mutation as the fake codex does, and answers per FAKE_CLAUDE_REVIEWER:
#   PASS | FAIL (default PASS)   a review ending in that VERDICT line
#   limit                        Claude refused the call, as above
#   FAKE_BUILDER=story      writes .stories/$FAKE_STORY_ID.md — fleet
#                           write-story's postcondition, not the launcher's.
#                           Dies loudly if .stories/TEMPLATE.md is not already
#                           in the cwd (the worktree write-story seeds it
#                           into). A well-formed story unless
#                           FAKE_STORY_NOAC=1, which omits the Acceptance
#                           criteria section — a lint failure the caller
#                           must still surface.
#
# Phase 3: FAKE_BUILDER_MUTATIONS makes the builder hand the harness its own
# TDD evidence — "the test I wrote goes red when the behaviour is removed" —
# in the same .review-out/mutations/ format the reviewer uses, slug-prefixed
# `tdd-` so the producer is visible:
#
#   none   (default) writes nothing
#   red    a patch that inserts FLEET_MUTANT_MARKER — the fake vitest in
#          `marker` mode then fails, so the claim holds
#   green  a patch that changes a comment only — nothing fails, so the
#          builder's "observed red" claim is false and the story must not pass
#   cargo-red  the red patch with a `cargo:` selector, for a target whose
#          RUNNERS list cargo (test/fakes/cargo in marker mode catches it)
#
# It records every call in $FAKE_TRACE_DIR/calls and saves the prompt it was
# given as $FAKE_TRACE_DIR/claude-prompt-N, and its argv as claude-args-N, so a
# test can assert which prompt the launcher rendered and which model it chose.
# Output is the one JSON object the launcher reads (`is_error`, `result`) —
# unless FAKE_BUILDER_OUTPUT says otherwise, for the paths where it is not:
#
#   garbage   `not json {` — not JSON at all
#   shape     `{"unexpected":"shape"}` — JSON, but not the CLI's object
#
# FAKE_BUILDER_USED=<model> adds `modelUsage` naming it — the model the
# requested alias resolved to.
#
# Sessions, as the real CLI has them: every object carries `session_id`,
# `fake-session-N` for the Nth builder call, and `--resume <id>` continues
# that session, so the object then names <id> again. A resumed call is the
# launcher's baseline fix (launch.ts): it does what FAKE_BUILDER_RESUMED
# says (default: FAKE_BUILDER), and its TDD evidence, when
# FAKE_BUILDER_MUTATIONS asks for some, is slugged `tdd-fixed` instead of
# `tdd-observed-red`, so a case can tell which call handed over the set.
# FAKE_BUILDER_MUTATIONS_RESUMED (default: FAKE_BUILDER_MUTATIONS) is the
# evidence a resumed call hands over — a tdd fix that makes a green pair red.
#
# FAKE_BUILDER_SEQ="commit blocked" gives the fresh (not resumed) calls one
# mode each, in order, the last word for every call after; FAKE_BUILDER is
# still required, and is what a resumed call falls back to.
#
set -euo pipefail
: "${FAKE_BUILDER:?FAKE_BUILDER must be set}"
: "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}"

# The prompt arrives on stdin (agents.ts passes it as the child's input — a
# 134 KB round-2 prompt exceeded the kernel's per-argument limit on 007's
# rerun) or, for older callers, as the value after -p. A `-p` followed by
# another flag has no value.
prompt=""
resume=""
ARGV=("$@")                           # before the loop below consumes them
while (($#)); do
  case "$1" in
    -p) if [[ -n "${2:-}" && "${2:-}" != -* ]]; then prompt="$2"; shift 2; else shift; fi ;;
    --resume) resume="${2:?fleet/test/fakes/claude: --resume needs a session id}"; shift 2 ;;
    *)  shift ;;
  esac
done
if [[ -z "$prompt" && ! -t 0 ]]; then prompt="$(cat)"; fi

limit_json() {
  local default="You've hit your limit · resets 3pm (Europe/Rome)"
  jq -cn --arg r "${FAKE_LIMIT_MSG:-$default}" \
    '{type:"result", subtype:"success", is_error:true, api_error_status:429, result:$r}'
}

if [[ "$PWD" == *-review ]]; then
  echo claude-review >> "$FAKE_TRACE_DIR/calls"
  r="$(grep -c '^claude-review$' "$FAKE_TRACE_DIR/calls")"
  printf '%s' "$prompt" > "$FAKE_TRACE_DIR/claude-review-prompt-$r"
  printf '%s\n' "${ARGV[@]}" > "$FAKE_TRACE_DIR/claude-review-args-$r"
  v="${FAKE_CLAUDE_REVIEWER:-PASS}"
  case "$v" in
    limit) limit_json; exit 1 ;;
    PASS|FAIL) : ;;
    *) echo "fleet/test/fakes/claude: unknown FAKE_CLAUDE_REVIEWER='$v'" >&2; exit 2 ;;
  esac
  if [[ "${FAKE_MUTATIONS:-none}" == patch ]]; then
    mkdir -p .review-out/mutations
    printf '\nFLEET_MUTANT_MARKER\n' >> src/marker.txt
    git diff -- src/marker.txt > .review-out/mutations/AC1-claude-marker.patch
    git checkout -q -- src/marker.txt
    printf 'fake.test.tsx\n' > .review-out/mutations/AC1-claude-marker.test
  fi
  jq -cn --arg t "fake claude review, call $r."$'\n'"VERDICT: $v" \
    '{type:"result", subtype:"success", is_error:false, result:$t, modelUsage:{"claude-opus-fake":{costUSD:1.0}}}'
  exit 0
fi

echo claude >> "$FAKE_TRACE_DIR/calls"
n="$(grep -c '^claude$' "$FAKE_TRACE_DIR/calls")"
printf '%s' "$prompt" > "$FAKE_TRACE_DIR/claude-prompt-$n"
# The argv too, one flag per line: which model the launcher chose is visible
# nowhere else.
printf '%s\n' "${ARGV[@]}" > "$FAKE_TRACE_DIR/claude-args-$n"
session="${resume:-fake-session-$n}"
mode="$FAKE_BUILDER"; slug=tdd-observed-red
evidence="${FAKE_BUILDER_MUTATIONS:-none}"
if [[ -n "${FAKE_BUILDER_SEQ:-}" && -z "$resume" ]]; then
  read -r -a seq <<< "$FAKE_BUILDER_SEQ"
  fresh="$({ grep -L -- '^--resume$' "$FAKE_TRACE_DIR"/claude-args-* || true; } | wc -l)"   # this call's argv is written
  mode="${seq[$(( fresh <= ${#seq[@]} ? fresh - 1 : ${#seq[@]} - 1 ))]}"
fi
if [[ -n "$resume" ]]; then mode="${FAKE_BUILDER_RESUMED:-$FAKE_BUILDER}"; slug=tdd-fixed; evidence="${FAKE_BUILDER_MUTATIONS_RESUMED:-$evidence}"; fi

case "$mode" in
  limit)    limit_json; exit 1 ;;
  commit-then-limit) git commit -q --allow-empty -m "fake(builder): round $n, then the limit"; limit_json; exit 1 ;;
  commit)   git commit -q --allow-empty -m "fake(builder): round $n" ;;
  nocommit) : ;;
  hang)     sleep 999 ;;
  blocked)  mkdir -p .blocked
            printf 'fake question: which option?\n' > ".blocked/${FAKE_STORY_ID:?FAKE_STORY_ID must be set}.md" ;;
  touch)    printf '\nfake builder touched this (call %s)\n' "$n" >> "${FAKE_TOUCH:?FAKE_TOUCH must be set}"
            git add -- "$FAKE_TOUCH"
            git commit -q -m "fake(builder): touch $FAKE_TOUCH" ;;
  story)    [[ -f .stories/TEMPLATE.md ]] || { echo "fleet/test/fakes/claude: no TEMPLATE.md in the worktree" >&2; exit 3; }
            mkdir -p .stories
            if [[ "${FAKE_STORY_NOAC:-0}" == 1 ]]; then
              printf -- '---\nstatus: draft\nround: 0\n---\n# Story: fake\n## Known weakness\nNone.\n## Out of scope\n- nothing\n' \
                > ".stories/${FAKE_STORY_ID:?FAKE_STORY_ID must be set}.md"
            else
              printf -- '---\nstatus: draft\nround: 0\n---\n# Story: fake\n## Acceptance criteria\n**AC1 - a bounded claim.** Goes red when removed.\n## Known weakness\nNone.\n## Out of scope\n- nothing\n' \
                > ".stories/${FAKE_STORY_ID:?FAKE_STORY_ID must be set}.md"
            fi ;;
  *) echo "fleet/test/fakes/claude: unknown FAKE_BUILDER='$mode'" >&2; exit 2 ;;
esac

# TDD evidence, written after the commit so the tree is clean apart from
# .review-out/ — the same contract the reviewer is held to.
red_pair() {      # red_pair <name> [selector]: a patch the fake vitest (or the fake cargo) catches
  mkdir -p .review-out/mutations
  printf '\nFLEET_MUTANT_MARKER\n' >> src/marker.txt
  git diff -- src/marker.txt > ".review-out/mutations/$1.patch"
  git checkout -q -- src/marker.txt
  printf '%s\n' "${2:-fake.test.tsx}" > ".review-out/mutations/$1.test"
}
green_pair() {    # green_pair <name>: a patch nothing catches
  mkdir -p .review-out/mutations
  printf '\n# a comment the suite cannot see\n' >> src/marker.txt
  git diff -- src/marker.txt > ".review-out/mutations/$1.patch"
  git checkout -q -- src/marker.txt
  printf 'fake.test.tsx\n' > ".review-out/mutations/$1.test"
}
# kept+red / kept+green: AC1-tdd-kept, a red pair made the same way at every
# call — the same bytes while the head stands — beside the call's own pair.
case "$evidence" in
  none) : ;;
  red)   red_pair "AC1-$slug" ;;
  cargo-red) red_pair "AC1-$slug" 'cargo:fake-core/scan::marker_absent' ;;
  green) green_pair "AC1-$slug" ;;
  kept+red)   red_pair AC1-tdd-kept; red_pair "AC1-$slug" ;;
  kept+green) red_pair AC1-tdd-kept; green_pair "AC1-$slug" ;;
  *) echo "fleet/test/fakes/claude: unknown TDD evidence mode '$evidence'" >&2; exit 2 ;;
esac

case "${FAKE_BUILDER_OUTPUT:-json}" in
  json)    if [[ -n "${FAKE_BUILDER_USED:-}" ]]; then   # the model an alias resolved to, as modelUsage reports it
             printf '{"is_error":false,"result":"fake builder did: %s (call %s)","session_id":"%s","modelUsage":{"claude-haiku-side":{"costUSD":0.01},"%s":{"costUSD":1.5}}}\n' "$mode" "$n" "$session" "$FAKE_BUILDER_USED"
           else
             printf '{"is_error":false,"result":"fake builder did: %s (call %s)","session_id":"%s"}\n' "$mode" "$n" "$session"
           fi ;;
  garbage) printf 'not json {\n' ;;
  shape)   printf '{"unexpected":"shape"}\n' ;;
  *) echo "fleet/test/fakes/claude: unknown FAKE_BUILDER_OUTPUT='$FAKE_BUILDER_OUTPUT'" >&2; exit 2 ;;
esac
