#!/usr/bin/env bash
#
# fleet/test/fakes/npm — tripwire under fleet/test/suite.sh.
#
# The launcher must not run a real install inside a test fixture; the suite
# sets INSTALL_CMD=true. If `npm` is reached anyway, the INSTALL_CMD seam is
# not honoured. Record the call so the test can see it, and fail the install.
#
echo "npm $*" >> "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}/calls"
exit 1
