#!/usr/bin/env bash
#
# fleet/test/fakes/codex — stand-in for the real `codex exec --json …` under fleet/test/suite.sh.
#
# The launcher invokes `codex` by bare name with the review prompt on stdin
# (ts/src/lib/agents.ts: `codex exec --json --sandbox danger-full-access
# [-m <model>]`), cwd = the reviewer worktree, and keeps only the reviewer's
# own messages (reviewerMessages): the .item.text of each line that is an
# `item.completed` event whose item is an `agent_message`.
# The verdict rule then reads `^VERDICT: (PASS|FAIL|SPEC)` from that text.
#
#   FAKE_REVIEWER=PASS | FAIL | SPEC   a well-formed verdict line
#   FAKE_REVIEWER=garbage              no line the launcher can parse → UNPARSEABLE
#   FAKE_REVIEWER=silent               a stream with no agent_message at all
#   FAKE_REVIEWER=hang                 never returns — for the agent-timeout case
#   FAKE_REVIEWER=limit                the provider refused: exactly the stream codex
#                                      printed on 21 Sep (khaita 015 round 3) — no
#                                      turn.completed, nothing under .review-out/ —
#                                      and exit FAKE_REVIEWER_EXIT (default 1)
#                                      FAKE_CODEX_RESETS_AT=<epoch> also writes a
#                                      rollout whose codex window is at 100% and
#                                      resets then, as the real sessions carry it
#   FAKE_REVIEWER=gate                 parks, its cwd in the reviewer worktree, until
#                                      $FAKE_TRACE_DIR/gate-open exists, then acts as
#                                      FAKE_GATE_THEN (default PASS) — a launcher held
#                                      mid-review for as long as a case needs it
#
# Phase 1.3+: the reviewer's output contract is files under .review-out/
# in its worktree. FAKE_MUTATIONS (default none) writes them:
#
#   none      nothing written
#   patch     .review-out/mutations/AC1-marker.patch + AC1-marker.test
#             The patch appends FLEET_MUTANT_MARKER to src/marker.txt;
#             fleet/test/fakes/vitest in `marker` mode fails iff that line exists.
#             The tree is left clean (patch generated, then reverted).
#   cmd       same patch, but AC1-marker.cmd instead of .test
#   badpatch  AC1-bad.patch that does not apply, + .test
#   ac2only   the marker patch filed as AC2-marker (AC1 has no mutation)
#   dirty     same as patch but the change is NOT reverted — contract broken
#
# Phase 3.2: FAKE_PROBES writes .review-out/probes/ — runnable tests the
# reviewer constructs to hunt regressions no existing test covers. No patch:
# the harness runs them against the tree as it stands. A RED probe vetoes.
#
#   none   (default) writes nothing — probes are optional and zero is not a finding
#   green  a probe the fake vitest passes (no regression found)
#   red    a probe the fake vitest fails (a regression the suite did not cover)
#
# FAKE_REVIEWER_USED=<model> writes a session file the way real codex does,
# under $CODEX_HOME/sessions/YYYY/MM/DD, whose turn_context names the cwd and
# the model — the only place codex records the model it ran on.
#
# Records calls in $FAKE_TRACE_DIR/calls and the prompt as codex-prompt-N.
#
set -euo pipefail
: "${FAKE_REVIEWER:?FAKE_REVIEWER must be set}"
: "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}"

# The prompt arrives on stdin (agents.ts passes it as the child's input;
# `codex exec` reads instructions from stdin when no positional prompt is
# given) or, for older callers, as the last argument.
if [[ ! -t 0 ]]; then prompt="$(cat)"; else prompt="${*: -1}"; fi
echo codex >> "$FAKE_TRACE_DIR/calls"
n="$(grep -c '^codex$' "$FAKE_TRACE_DIR/calls")"
if [[ -n "${FAKE_REVIEWER_USED:-}" ]]; then
  d="${CODEX_HOME:?FAKE_REVIEWER_USED needs CODEX_HOME}/sessions/2026/09/24"
  mkdir -p "$d"
  printf '{"type":"session_meta","payload":{"cwd":"%s"}}\n{"type":"turn_context","payload":{"cwd":"%s","model":"%s"}}\n' \
    "$PWD" "$PWD" "$FAKE_REVIEWER_USED" > "$d/rollout-fake-$n.jsonl"
fi
printf '%s' "$prompt" > "$FAKE_TRACE_DIR/codex-prompt-$n"
printf '%s\n' "$@" > "$FAKE_TRACE_DIR/codex-args-$n"

if [[ "$FAKE_REVIEWER" == limit ]]; then
  if [[ -n "${FAKE_CODEX_RESETS_AT:-}" ]]; then
    d="${CODEX_HOME:?FAKE_CODEX_RESETS_AT needs CODEX_HOME}/sessions/2026/09/21"
    mkdir -p "$d"
    jq -cn --argjson r "$FAKE_CODEX_RESETS_AT" \
      '{type:"event_msg", payload:{type:"token_count", rate_limits:{limit_id:"codex", primary:{used_percent:100.0, window_minutes:300, resets_at:$r}, secondary:{used_percent:16.0, window_minutes:10080, resets_at:($r + 586800)}}}}' \
      > "$d/rollout-fake-limit-$n.jsonl"
  fi
  msg="You've hit your usage limit. Upgrade to Pro (https://chatgpt.com/explore/pro), visit https://chatgpt.com/codex/settings/usage to purchase more credits or try again at 2:17 PM."
  echo "Reading prompt from stdin..." >&2
  jq -cn '{type:"thread.started", thread_id:"01a0c3a2-5a0d-7a33-a3d4-55f3ec6edc49"}'
  jq -cn '{type:"turn.started"}'
  jq -cn --arg m "$msg" '{type:"error", message:$m}'
  jq -cn --arg m "$msg" '{type:"turn.failed", error:{message:$m}}'
  exit "${FAKE_REVIEWER_EXIT:-1}"
fi

if [[ "$FAKE_REVIEWER" == gate ]]; then
  until [[ -e "$FAKE_TRACE_DIR/gate-open" ]]; do sleep 0.05; done
  FAKE_REVIEWER="${FAKE_GATE_THEN:-PASS}"
fi

marker_patch() {                      # marker_patch <ac> <ext> [keep] — write the mutation files
  local ac="$1" ext="$2" keep="${3:-}" out=.review-out/mutations
  mkdir -p "$out"
  printf '\nFLEET_MUTANT_MARKER\n' >> src/marker.txt
  git diff -- src/marker.txt > "$out/$ac-marker.patch"
  [[ -n "$keep" ]] || git checkout -q -- src/marker.txt
  case "$ext" in
    test) printf 'fake.test.tsx\n' > "$out/$ac-marker.test" ;;
    cmd)  printf 'grep -q FLEET_MUTANT_MARKER src/marker.txt && exit 1 || exit 0\n' > "$out/$ac-marker.cmd" ;;
  esac
}

case "${FAKE_MUTATIONS:-none}" in
  none)     : ;;
  patch)    marker_patch AC1 test ;;
  cmd)      marker_patch AC1 cmd ;;
  ac2only)  marker_patch AC2 test ;;
  dirty)    marker_patch AC1 test keep ;;
  badpatch) mkdir -p .review-out/mutations
            printf -- '--- a/nope.txt\n+++ b/nope.txt\n@@ -1 +1 @@\n-this line does not exist\n+so this cannot apply\n' > .review-out/mutations/AC1-bad.patch
            printf 'fake.test.tsx\n' > .review-out/mutations/AC1-bad.test ;;
  *) echo "fleet/test/fakes/codex: unknown FAKE_MUTATIONS='$FAKE_MUTATIONS'" >&2; exit 2 ;;
esac

# A probe carries no patch and needs no selector — the file IS both. Its name
# tells the fake vitest what to report, so a probe can fail while the suite
# around it passes, which is the whole point of a probe.
case "${FAKE_PROBES:-none}" in
  none) : ;;
  green|red) mkdir -p .review-out/probes
             printf '// fake probe (%s)\n' "$FAKE_PROBES" \
               > ".review-out/probes/probe-$FAKE_PROBES.test.tsx" ;;
  *) echo "fleet/test/fakes/codex: unknown FAKE_PROBES='$FAKE_PROBES'" >&2; exit 2 ;;
esac

[[ "$FAKE_REVIEWER" == hang ]] && sleep 999

case "$FAKE_REVIEWER" in
  PASS|FAIL|SPEC) text=$'fake review, call '"$n"$'.\nfinding: none.\nVERDICT: '"$FAKE_REVIEWER" ;;
  garbage)        text=$'fake review, call '"$n"$'.\nverdict: pass (lowercase, not the contract)' ;;
  silent)         text="" ;;
  *) echo "fleet/test/fakes/codex: unknown FAKE_REVIEWER='$FAKE_REVIEWER'" >&2; exit 2 ;;
esac

# Output shaped like real codex 0.153 (read from a real run, 17 Sep):
#   stderr  "Reading prompt from stdin..." when stdin is not a TTY (this text since at least 22 Sep; "Reading additional input from stdin..." on 17 Sep) —
#           always on, because that is what every unattended run sees
#   stdout  JSON Lines: thread.started, command_execution items (no .text),
#           then the agent_message that carries the verdict, then turn.completed
echo "Reading prompt from stdin..." >&2
jq -cn '{type:"thread.started", thread_id:"fake"}'
jq -cn '{type:"item.started",   item:{id:"item_1", type:"command_execution", command:"/bin/bash -lc \"npm test\""}}'
jq -cn '{type:"item.completed", item:{id:"item_1", type:"command_execution", command:"/bin/bash -lc \"npm test\"", exit_code:0}}'
[[ "$FAKE_REVIEWER" == silent ]] || jq -cn --arg t "$text" '{type:"item.completed", item:{id:"item_2", type:"agent_message", text:$t}}'
jq -cn '{type:"turn.completed", usage:{input_tokens:1, output_tokens:1}}'
