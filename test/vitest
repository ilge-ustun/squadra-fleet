#!/usr/bin/env bash
#
# fleet/test/vitest — stand-in for `npx vitest run …` under fleet/test-lib.sh.
#
# The launcher runs `$VITEST_CMD <selector…> --reporter json --outputFile <f>`
# for the baseline and (Phase 1.4) each mutation, then reads <f>. This writes
# <f> in the shape vitest 3.2.7 actually produces — verified on the real repo,
# 17 Sep 2026, not from memory:
#
#   pass     numTotalTests>0, numFailedTests=0, success=true
#   fail     numFailedTests>0, an assertionResult with status "failed", success=false
#   notests  numTotalTests=0, numFailedTestSuites=1, success=false,
#            suite message "Transform failed …"                       (L-08)
#
#   FAKE_VITEST=pass | fail | notests
#   FAKE_VITEST=marker   fail iff a file under cwd contains FLEET_MUTANT_MARKER
#                        (Phase 1.4: the fake mutation patch inserts that line)
#
set -euo pipefail
: "${FAKE_VITEST:?FAKE_VITEST must be set}"
: "${FAKE_TRACE_DIR:?FAKE_TRACE_DIR must be set}"

out=""; sel=()
while (($#)); do
  case "$1" in
    --outputFile)   out="${2:-}"; shift 2 ;;
    --outputFile=*) out="${1#*=}"; shift ;;
    --reporter)     shift 2 ;;
    *)              sel+=("$1"); shift ;;
  esac
done
printf 'vitest %s\n' "${sel[*]:-}" >> "$FAKE_TRACE_DIR/calls"

mode="$FAKE_VITEST"
if [[ "$mode" == marker ]]; then
  if grep -rq --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=.next FLEET_MUTANT_MARKER .; then
    mode=fail
  else
    mode=pass
  fi
fi

case "$mode" in
  pass)
    rc=0; json='{"numTotalTestSuites":1,"numPassedTestSuites":1,"numFailedTestSuites":0,"numTotalTests":2,"numPassedTests":2,"numFailedTests":0,"numPendingTests":0,"success":true,"testResults":[{"name":"fake.test.tsx","status":"passed","message":"","assertionResults":[{"fullName":"fake suite a","status":"passed","failureMessages":[]},{"fullName":"fake suite b","status":"passed","failureMessages":[]}]}]}' ;;
  fail)
    rc=1; json='{"numTotalTestSuites":1,"numPassedTestSuites":0,"numFailedTestSuites":1,"numTotalTests":2,"numPassedTests":1,"numFailedTests":1,"numPendingTests":0,"success":false,"testResults":[{"name":"fake.test.tsx","status":"failed","message":"","assertionResults":[{"fullName":"fake suite a","status":"failed","failureMessages":["AssertionError: expected 1 to be 2"]},{"fullName":"fake suite b","status":"passed","failureMessages":[]}]}]}' ;;
  notests)
    rc=1; json='{"numTotalTestSuites":1,"numPassedTestSuites":0,"numFailedTestSuites":1,"numTotalTests":0,"numPassedTests":0,"numFailedTests":0,"numPendingTests":0,"success":false,"testResults":[{"name":"fake.test.tsx","status":"failed","message":"Transform failed with 1 error","assertionResults":[]}]}' ;;
  *) echo "fleet/test/vitest: unknown FAKE_VITEST='$FAKE_VITEST'" >&2; exit 2 ;;
esac

[[ -n "$out" ]] && printf '%s\n' "$json" > "$out"
exit "$rc"
