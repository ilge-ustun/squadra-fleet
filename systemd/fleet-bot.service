[Unit]
Description=fleet — read and answer Telegram commands
Documentation=file:///home/fleet/work/fleet/systemd/README.md
After=network-online.target

[Service]
Type=oneshot

# oneshot again: while a poll is running the timer's next firing is skipped
# rather than queued, so two pollers can never read the same update.

WorkingDirectory=/home/fleet/work/fleet

# node and git are all this needs; claude and codex are not on the path of
# a poll. Kept identical to fleet-queue.service so there is one PATH to fix.
Environment=PATH=/home/fleet/.local/bin:/home/fleet/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/fleet

ExecStart=/bin/bash /home/fleet/work/fleet/fleet telegram poll

# A poll is one HTTPS request and a handful of git commands. If it has not
# finished in two minutes something is wrong, and the next firing will retry.
TimeoutStartSec=2min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-bot

[Install]
WantedBy=default.target
