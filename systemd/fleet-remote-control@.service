[Unit]
Description=fleet — a Claude Code Remote Control server for the coordinator of %i
Documentation=file:///home/fleet/work/fleet/systemd/README.md
After=network-online.target

# Never stop restarting: a network that stays down for an hour after a
# maintenance must not leave the unit failed for good.
StartLimitIntervalSec=0

[Service]
Type=simple

# The sessions work in the repo's checkout (repos/%i.env); `claude` must have
# been trusted there once. The instance name is the server's name in the app.
WorkingDirectory=/home/fleet/work/fleet

# The same PATH as fleet-queue@.service: a coordinator's session runs the
# fleet, git, node and npm.
Environment=PATH=/home/fleet/.local/bin:/home/fleet/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/fleet

ExecStart=/bin/bash /home/fleet/work/fleet/fleet remote-control %i

# Always, not on-failure: the server is meant to be there whenever someone
# opens the app, whatever ended it. Stopping or restarting the unit ends
# every session it holds.
Restart=always
RestartSec=30

# stdout is the server's screen, drawn again every second: in the journal it
# was 96% of the lines and pushed the queue's history out (26 Oct). Errors
# go to stderr and stay; to see the screen, run the command in a terminal.
StandardOutput=null
StandardError=journal
SyslogIdentifier=fleet-remote-control-%i

# A coordinator's session builds and tests as a lane does, beside the
# drains, and the qr unit stopped with a 5.9 GB peak, cache included, on the
# 7.9 GB box (28 Oct). Past MemoryHigh the kernel slows the unit and takes
# back its cache, then swaps it; it never kills it. 2500M is the server
# (~150 MB), two sessions (~250 MB each) and one build as large as a lane's
# 1.8 GB peak; the queue's 3000M stays the larger share. Every unit of the
# user manager gets an OOM score of 200, so at 300 the kernel ends a session
# here before a drain, and the dashboard (500) before either.
MemoryHigh=2500M
OOMScoreAdjust=300

[Install]
WantedBy=default.target
